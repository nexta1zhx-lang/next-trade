{
  "name": "nexttrade",
  "private": true,
  "scripts": {
    "dev": "lsof -ti:3000,3001 | xargs kill -9 2>/dev/null; pnpm --parallel -r run dev",
    "build": "pnpm -r run build",
    "lint": "pnpm -r run lint",
    "clean": "pnpm -r run clean",
    "kill": "lsof -ti:3000,3001 | xargs kill -9 2>/dev/null; echo 'ports 3000,3001 freed'",
    "db:push": "pnpm --filter @nexttrade/api run db:push",
    "deploy": "bash scripts/deploy.sh",
    "deploy:api": "bash scripts/deploy.sh api",
    "deploy:web": "bash scripts/deploy.sh web",
    "deploy:db": "bash scripts/deploy.sh --db-push",
    "deploy:caddy": "echo '▶ 重启 Caddy...' && ssh aws2 'cd ~/nextTrade && docker compose -f docker-compose.prod.yml up -d --force-recreate caddy'",
    "apk": "bash scripts/build-apk.sh",
    "apk:dev": "bash scripts/build-apk.sh --dev",
    "apk:upload": "bash scripts/build-apk.sh --no-upload",
    "changelog": "bash scripts/gen-changelog.sh",
    "release": "bash scripts/build-apk.sh &&  bash scripts/deploy.sh --db-push",
    "release:dev": "bash scripts/build-apk.sh --dev && bash scripts/deploy.sh",
    "docker-d": "docker compose up -d"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  }
}
