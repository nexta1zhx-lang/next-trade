bitcoooin.cn {
    # 自动 HTTPS（Caddy 自动申请和续期 SSL 证书）
    
    # 关闭访问日志（避免内存积累 + Via 头膨胀）
    log {
        output discard
    }

    # 清理请求/响应中的 Via 头，防止代理链无限累加
    header / {
        -Via
    }

    # APK 等静态文件下载
    handle_path /downloads/* {
        root * /downloads
        file_server browse

        # JSON 文件不缓存（versions.json 需要实时读取）
        @json {
            path *.json
        }
        header @json Cache-Control "no-cache, no-store, must-revalidate"

        # APK 文件缓存 1 小时
        @apk {
            path *.apk
        }
        header @apk Cache-Control "public, max-age=3600"
    }

    # API 请求直连后端（使用 handle 而非 handle_path，避免剥离 /api 前缀）
    handle /api/* {
        reverse_proxy api:3001
    }

    # WebSocket 请求直连后端
    handle /ws/* {
        reverse_proxy api:3001
    }

    # 前端静态文件（由 web 容器的 busybox httpd 提供）
    handle {
        reverse_proxy web:3000
    }
}
