bitcoooin.cn {
    # 自动 HTTPS（Caddy 自动申请和续期 SSL 证书）

    # APK 等静态文件下载
    handle_path /downloads/* {
        root * /downloads
        file_server browse
    }

    # API 请求直连后端（使用 handle 而非 handle_path，避免剥离 /api 前缀）
    handle /api/* {
        reverse_proxy api:3001
    }

    # WebSocket 请求直连后端
    handle /ws/* {
        reverse_proxy api:3001
    }

    # 前端所有请求转发到 Next.js
    handle {
        reverse_proxy web:3000
    }
}
